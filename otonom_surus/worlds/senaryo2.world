<?xml version="1.0"?>
<!--
  Senaryo 2: 6 x 6 m kapalı oda, iki iç duvarla zikzak koridor + 4 statik engel.
  Oda içi x, y ∈ [-1, 5]; robot (0, 0)'da doğar. Hedefler sırayla (4, 0) → (4, 4) → (0, 4).
  İç duvarlar odayı üç koridora böler; kapılar zıt uçlarda olduğundan (4, 0) → (4, 4) için
  robot doğu kapısından orta koridora girip batı kapısından üst koridora çıkmak zorunda:
    duvar_1  y = 1.0, kapı x ∈ [3.6, 4.4] (0.8 m, (4, 0) hedefinin tam kuzeyinde)
    duvar_2  y = 3.0, kapı x ∈ [-0.4, 0.4] (0.8 m, (0, 4) hedefinin tam güneyinde)
  Kapılar oda duvarından 0.6 m içeride: robot oda duvarına sürtünerek geçerse duvarı çok sığ
  açıyla tarar, SLAM haritasında duvar delinir ve planlayıcı delikten oda dışına (bilinmeyen =
  serbest) kısayol bulur. Orta koridordaki kutu duvar_1'e yaslıdır, üstünde 0.9 m geçit kalır;
  alt ve üst koridordaki silindirler düz rotayı kapatır. Yalnızca ilkel şekiller.
-->
<sdf version="1.6">
  <world name="senaryo2">

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>2.0 -2.6 6.2 0 0.9 1.5708</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Oda: iç yüzeyler x = -1, x = 5, y = -1, y = 5. Kalınlık 0.15 m, yükseklik 0.5 m. -->
    <model name="oda">
      <static>true</static>
      <link name="duvarlar">
        <collision name="guney_c">
          <pose>2.0 -1.075 0.25 0 0 0</pose>
          <geometry><box><size>6.3 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="guney_v">
          <pose>2.0 -1.075 0.25 0 0 0</pose>
          <geometry><box><size>6.3 0.15 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="kuzey_c">
          <pose>2.0 5.075 0.25 0 0 0</pose>
          <geometry><box><size>6.3 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="kuzey_v">
          <pose>2.0 5.075 0.25 0 0 0</pose>
          <geometry><box><size>6.3 0.15 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="bati_c">
          <pose>-1.075 2.0 0.25 0 0 0</pose>
          <geometry><box><size>0.15 6.0 0.5</size></box></geometry>
        </collision>
        <visual name="bati_v">
          <pose>-1.075 2.0 0.25 0 0 0</pose>
          <geometry><box><size>0.15 6.0 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="dogu_c">
          <pose>5.075 2.0 0.25 0 0 0</pose>
          <geometry><box><size>0.15 6.0 0.5</size></box></geometry>
        </collision>
        <visual name="dogu_v">
          <pose>5.075 2.0 0.25 0 0 0</pose>
          <geometry><box><size>0.15 6.0 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- İç duvarlar (zikzak koridor). Kalınlık 0.15 m; uçları oda duvarına değer. -->
    <model name="ic_duvarlar">
      <static>true</static>
      <link name="duvarlar">
        <!-- duvar_1: x ∈ [-1, 3.6] ve [4.4, 5] -->
        <collision name="duvar_1a_c">
          <pose>1.3 1.0 0.25 0 0 0</pose>
          <geometry><box><size>4.6 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="duvar_1a_v">
          <pose>1.3 1.0 0.25 0 0 0</pose>
          <geometry><box><size>4.6 0.15 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="duvar_1b_c">
          <pose>4.7 1.0 0.25 0 0 0</pose>
          <geometry><box><size>0.6 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="duvar_1b_v">
          <pose>4.7 1.0 0.25 0 0 0</pose>
          <geometry><box><size>0.6 0.15 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
        <!-- duvar_2: x ∈ [-1, -0.4] ve [0.4, 5] -->
        <collision name="duvar_2a_c">
          <pose>-0.7 3.0 0.25 0 0 0</pose>
          <geometry><box><size>0.6 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="duvar_2a_v">
          <pose>-0.7 3.0 0.25 0 0 0</pose>
          <geometry><box><size>0.6 0.15 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="duvar_2b_c">
          <pose>2.7 3.0 0.25 0 0 0</pose>
          <geometry><box><size>4.6 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="duvar_2b_v">
          <pose>2.7 3.0 0.25 0 0 0</pose>
          <geometry><box><size>4.6 0.15 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Alt koridor: (0, 0) → (4, 0) doğrusunu kapatır; güneyi 0.3 m (geçilmez), kuzeyi 1.0 m. -->
    <model name="silindir_1">
      <static>true</static>
      <pose>2.0 -0.4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.4 0.8 1</ambient>
            <diffuse>0.15 0.4 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Orta koridor: duvar_1'e yaslı kutu; kapılar arasındaki çapraz rotayı kapatır, üstünde
         duvar_2'ye 0.9 m dar geçit kalır. -->
    <model name="kutu_1">
      <static>true</static>
      <pose>2.4 1.55 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.95 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.95 0.5</size></box></geometry>
          <material>
            <ambient>0.9 0.45 0.1 1</ambient>
            <diffuse>0.9 0.45 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Üst koridor slalomu: silindir_2 kuzeye, silindir_3 güneye yaslı; aralarında 1.0 m. -->
    <model name="silindir_2">
      <static>true</static>
      <pose>2.0 4.35 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.4 0.8 1</ambient>
            <diffuse>0.15 0.4 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="silindir_3">
      <static>true</static>
      <pose>3.2 3.45 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.4 0.8 1</ambient>
            <diffuse>0.15 0.4 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Hedef bölgeleri: yalnızca görsel (collision yok → LiDAR görmez, robot üstünden geçer). -->
    <model name="hedef_1">
      <static>true</static>
      <pose>4.0 0.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.004</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.75 0.2 1</ambient>
            <diffuse>0.1 0.75 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="hedef_2">
      <static>true</static>
      <pose>4.0 4.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.004</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.75 0.2 1</ambient>
            <diffuse>0.1 0.75 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="hedef_3">
      <static>true</static>
      <pose>0.0 4.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.004</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.75 0.2 1</ambient>
            <diffuse>0.1 0.75 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
