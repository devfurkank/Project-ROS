<?xml version="1.0"?>
<!--
  Senaryo 3: 6 x 6 m kapalı oda + 2 statik engel + robotun yolunu kesen 2 hareketli kutu.
  Oda içi x, y ∈ [-1, 5]; robot (0, 0)'da doğar, hedef (4, 4).
  Hareketli kutular (0.4 x 0.4 x 0.5 m, 5 kg) gazebo_ros_planar_move eklentisiyle sürülür;
  obstacle_mover düğümü /engelN/cmd_vel'e komut verir (şerit uzunluğu ve hız scenarios.yaml'da):
    engel1  (0.4, 1.5)'ten +x yönünde 1.5 m → (0, 0) → (4, 4) doğrusunu (1.5, 1.5)'te keser
    engel2  (3.1, 2.7)'den +y yönünde 1.2 m → doğruyu (3.1, 3.1)'de keser
  Şeritler kısa ve uçlarında ≥ 0.8 m boşluk var: SLAM haritası kutunun geçtiği yerleri bir
  süre dolu sayabilir ("hayalet iz"); o zaman da şeridin ucundan dolanılabilir (R5).
  engel2'nin şeridi önce y = 2.3'ten başlıyordu: robot şeridin güney ucunu kutu_1 ile arasından
  dönerken kutu geri iniyor ve robotun yanına çarpıyordu (7 koşunun 3'ünde ayak izi ile kutu
  arası < 1 cm, 6'sında < 5 cm; DWB engelin hızını bilmez, kutunun o anki yerine göre planlar).
  Yalnızca ilkel şekiller.
-->
<sdf version="1.6">
  <world name="senaryo3">

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>2.0 -2.6 6.2 0 0.9 1.5708</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Oda: iç yüzeyler x = -1, x = 5, y = -1, y = 5. Kalınlık 0.15 m, yükseklik 0.5 m. -->
    <model name="oda">
      <static>true</static>
      <link name="duvarlar">
        <collision name="guney_c">
          <pose>2.0 -1.075 0.25 0 0 0</pose>
          <geometry><box><size>6.3 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="guney_v">
          <pose>2.0 -1.075 0.25 0 0 0</pose>
          <geometry><box><size>6.3 0.15 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="kuzey_c">
          <pose>2.0 5.075 0.25 0 0 0</pose>
          <geometry><box><size>6.3 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="kuzey_v">
          <pose>2.0 5.075 0.25 0 0 0</pose>
          <geometry><box><size>6.3 0.15 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="bati_c">
          <pose>-1.075 2.0 0.25 0 0 0</pose>
          <geometry><box><size>0.15 6.0 0.5</size></box></geometry>
        </collision>
        <visual name="bati_v">
          <pose>-1.075 2.0 0.25 0 0 0</pose>
          <geometry><box><size>0.15 6.0 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="dogu_c">
          <pose>5.075 2.0 0.25 0 0 0</pose>
          <geometry><box><size>0.15 6.0 0.5</size></box></geometry>
        </collision>
        <visual name="dogu_v">
          <pose>5.075 2.0 0.25 0 0 0</pose>
          <geometry><box><size>0.15 6.0 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Statik engeller (az): rotanın yanlarında. -->
    <model name="kutu_1">
      <static>true</static>
      <pose>3.8 0.9 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.4 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.4 0.5</size></box></geometry>
          <material>
            <ambient>0.9 0.45 0.1 1</ambient>
            <diffuse>0.9 0.45 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="silindir_1">
      <static>true</static>
      <pose>0.9 3.4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.4 0.8 1</ambient>
            <diffuse>0.15 0.4 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Hareketli kutular: statik DEĞİL. Sürtünme 0: planar_move hızı doğrudan atar, zeminle
      sürtünme kutuyu devirmesin/titretmesin. Eklenti /engelN/odom'da kutunun dünyadaki
      konumunu yayınlar (obstacle_mover dönüş noktalarını buna göre belirler); TF YAYINLAMAZ:
      publish_odom_tf açık olsaydı odom -> base_footprint'i yayınlayıp robotun TF ağacını
      bozardı (T6).
    -->
    <model name="engel1">
      <pose>0.4 1.5 0.25 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.1708</ixx><iyy>0.1708</iyy><izz>0.1333</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <surface>
            <friction><ode><mu>0</mu><mu2>0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <material>
            <ambient>0.85 0.15 0.15 1</ambient>
            <diffuse>0.85 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin name="engel1_move" filename="libgazebo_ros_planar_move.so">
        <ros><namespace>/engel1</namespace></ros>
        <update_rate>50</update_rate>
        <publish_rate>10</publish_rate>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
        <odometry_frame>world</odometry_frame>
        <robot_base_frame>engel1</robot_base_frame>
      </plugin>
    </model>

    <model name="engel2">
      <pose>3.1 2.7 0.25 0 0 1.5708</pose>
      <link name="link">
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.1708</ixx><iyy>0.1708</iyy><izz>0.1333</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <surface>
            <friction><ode><mu>0</mu><mu2>0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <material>
            <ambient>0.85 0.15 0.15 1</ambient>
            <diffuse>0.85 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin name="engel2_move" filename="libgazebo_ros_planar_move.so">
        <ros><namespace>/engel2</namespace></ros>
        <update_rate>50</update_rate>
        <publish_rate>10</publish_rate>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
        <odometry_frame>world</odometry_frame>
        <robot_base_frame>engel2</robot_base_frame>
      </plugin>
    </model>

    <!-- Hedef bölgesi: yalnızca görsel (collision yok → LiDAR görmez, robot üstünden geçer). -->
    <model name="hedef">
      <static>true</static>
      <pose>4.0 4.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.004</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.75 0.2 1</ambient>
            <diffuse>0.1 0.75 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
