<?xml version="1.0"?>
<!--
  Senaryo 1: 6 x 6 m kapalı oda + 6 dağınık statik engel.
  Oda içi x, y ∈ [-1, 5]; robot (0, 0)'da doğar, hedef (4, 4).
  (0, 0) → (4, 4) doğrusu kutu_1 ve silindir_1 ile kapalı; robot dolanmak zorunda.
  Tüm geçitler ≥ 0.75 m. Yalnızca ilkel şekiller (çevrimiçi model:// yok).
  Engeller 0.5 m yüksek; LiDAR düzlemi ≈ 0.18 m.
-->
<sdf version="1.6">
  <world name="senaryo1">

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>2.0 -2.6 6.2 0 0.9 1.5708</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Oda: iç yüzeyler x = -1, x = 5, y = -1, y = 5. Kalınlık 0.15 m, yükseklik 0.5 m. -->
    <model name="oda">
      <static>true</static>
      <link name="duvarlar">
        <collision name="guney_c">
          <pose>2.0 -1.075 0.25 0 0 0</pose>
          <geometry><box><size>6.3 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="guney_v">
          <pose>2.0 -1.075 0.25 0 0 0</pose>
          <geometry><box><size>6.3 0.15 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="kuzey_c">
          <pose>2.0 5.075 0.25 0 0 0</pose>
          <geometry><box><size>6.3 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="kuzey_v">
          <pose>2.0 5.075 0.25 0 0 0</pose>
          <geometry><box><size>6.3 0.15 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="bati_c">
          <pose>-1.075 2.0 0.25 0 0 0</pose>
          <geometry><box><size>0.15 6.0 0.5</size></box></geometry>
        </collision>
        <visual name="bati_v">
          <pose>-1.075 2.0 0.25 0 0 0</pose>
          <geometry><box><size>0.15 6.0 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="dogu_c">
          <pose>5.075 2.0 0.25 0 0 0</pose>
          <geometry><box><size>0.15 6.0 0.5</size></box></geometry>
        </collision>
        <visual name="dogu_v">
          <pose>5.075 2.0 0.25 0 0 0</pose>
          <geometry><box><size>0.15 6.0 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Statik engeller: kutular turuncu, silindirler mavi. -->
    <model name="kutu_1">
      <static>true</static>
      <pose>1.5 1.5 0.25 0 0 0.35</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material>
            <ambient>0.9 0.45 0.1 1</ambient>
            <diffuse>0.9 0.45 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="kutu_2">
      <static>true</static>
      <pose>3.4 0.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.3 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.3 0.5</size></box></geometry>
          <material>
            <ambient>0.9 0.45 0.1 1</ambient>
            <diffuse>0.9 0.45 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="kutu_3">
      <static>true</static>
      <pose>0.5 3.6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 1.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 1.0 0.5</size></box></geometry>
          <material>
            <ambient>0.9 0.45 0.1 1</ambient>
            <diffuse>0.9 0.45 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="silindir_1">
      <static>true</static>
      <pose>3.0 3.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.4 0.8 1</ambient>
            <diffuse>0.15 0.4 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="silindir_2">
      <static>true</static>
      <pose>4.0 2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.4 0.8 1</ambient>
            <diffuse>0.15 0.4 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="silindir_3">
      <static>true</static>
      <pose>0.0 1.9 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.4 0.8 1</ambient>
            <diffuse>0.15 0.4 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Hedef bölgesi: yalnızca görsel (collision yok → LiDAR görmez, robot üstünden geçer). -->
    <model name="hedef">
      <static>true</static>
      <pose>4.0 4.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.004</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.75 0.2 1</ambient>
            <diffuse>0.1 0.75 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
